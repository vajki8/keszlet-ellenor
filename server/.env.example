# Másold le ".env" néven ebbe a mappába, és töltsd ki a saját értékeiddel.

# UNAS API kulcs (Webshop admin -> Beállítások -> API)
UNAS_API_KEY=
UNAS_API_URL=https://api.unas.eu/shop

# A Teams "Sync" gombbal helyben szinkronizált csatorna-mappa útvonala,
# ahova a Hansa export fájl kerül. Windows-on valami ilyesmi:
# C:\Users\<neved>\Cégnév\Csapatnév - Csatornanév
LOCAL_HANSA_FOLDER=

# Opcionális: mely origin(ek)ből engedélyezett a böngészős hívás (CORS).
# Üresen hagyva minden origin engedélyezett.
ALLOWED_ORIGIN=

# Opcionális: cron kifejezés a napi automata futáshoz (alapértelmezett: 0 10 * * * = minden nap 10:00).
SYNC_CRON=

# Opcionális: HTTP port (alapértelmezett: 8080)
PORT=8080
